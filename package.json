{
  "name": "validate-intentspec-action",
  "version": "1.2.2",
  "description": "GitHub Action that validates intent.md files against the IntentSpec schema.",
  "main": "dist/index.js",
  "bin": {
    "intentspec": "./dist/index.js"
  },
  "scripts": {
    "test": "node test/run.js",
    "build": "ncc build src/index.ts -o dist && cp src/schema.json dist/ && npx tsc src/normalize.ts --outDir dist --module commonjs --target es2020 --skipLibCheck && mv dist/normalize.js dist/normalize-for-test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "Janne Lammi",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.1.0",
    "@vercel/ncc": "^0.38.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "@types/js-yaml": "^4.0.9"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathmodeio/validate-intentspec-action.git"
  },
  "homepage": "https://intentspec.org",
  "bugs": {
    "url": "https://github.com/pathmodeio/validate-intentspec-action/issues"
  }
}
